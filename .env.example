# Core runtime
WEEBARR_HOST=0.0.0.0
WEEBARR_PORT=8888
WEEBARR_LOG_LEVEL=INFO

# Public deployment
# Required for public/reverse-proxy/Plex-auth use. Set this to the external URL users visit.
WEEBARR_PUBLIC_URL=https://weebarr.example.com

# Optional remote first-run bootstrap. Leave blank unless you intentionally need to claim
# a brand-new instance through a public URL or reverse proxy.
WEEBARR_BOOTSTRAP_TOKEN=
# WEEBARR_BOOTSTRAP_TOKEN_HASH=

# Optional bootstrap by environment instead of first-run setup
# WEEBARR_AUTH_USERNAME=admin
# WEEBARR_AUTH_PASSWORD=
# WEEBARR_AUTH_PASSWORD_HASH=
# WEEBARR_SESSION_SECRET=

# Optional automation API key for safe read/request API usage
# WEEBARR_API_KEY=
# WEEBARR_API_KEY_HASH=

# App behavior
WEEBARR_CONTENT_FILTER_MODE=hide_nsfw
WEEBARR_STRICT_MONITORING=false

# External service connection
SEERR_BASE_URL=http://seerr:5055
SEERR_API_KEY=change-me
SEERR_REQUEST_SEASONS=all

# Lightweight in-app rate limits
WEEBARR_LOGIN_RATE_LIMIT_ATTEMPTS=5
WEEBARR_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
WEEBARR_SETUP_RATE_LIMIT_ATTEMPTS=5
WEEBARR_SETUP_RATE_LIMIT_WINDOW_SECONDS=600
WEEBARR_PLEX_RATE_LIMIT_ATTEMPTS=8
WEEBARR_PLEX_RATE_LIMIT_WINDOW_SECONDS=300
